# Copie este arquivo para ".env" e preencha os valores.
# NUNCA envie o arquivo ".env" ao GitHub (ele já está no .gitignore).

# Chave de API do seu provedor (obrigatória para o chat funcionar).
OPENAI_API_KEY=sua-chave-de-api-aqui

# Endereço do provedor (opcional). Se não definir, usa o da OpenAI.
# Exemplos de provedores compatíveis com a API da OpenAI:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Ollama local: http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo usado nas respostas (o nome depende do provedor).
OPENAI_MODEL=gpt-4o-mini

# Opcionais
# Quantas mensagens anteriores são enviadas à IA como contexto (1 a 50).
MAX_CONTEXT_MESSAGES=10
